# Postgres (servicio camevo-db en docker-compose.yml)
# En producción (docker-compose.prod.yml) POSTGRES_PASSWORD es obligatoria
# — no hay default "camevo": el stack de producción falla al arrancar si
# no se define acá, en vez de quedar expuesto con la contraseña de
# desarrollo. POSTGRES_PORT solo aplica en desarrollo (Postgres no se
# publica al host en producción, ver docker-compose.prod.yml).
POSTGRES_USER=camevo
POSTGRES_PASSWORD=camevo
POSTGRES_DB=camevo
POSTGRES_PORT=5432

# apps/api
# En desarrollo, DATABASE_URL apunta a localhost (Postgres publicado al
# host). En producción debe usar el nombre del servicio Docker
# (camevo-db), no localhost — los contenedores se resuelven por nombre
# dentro de la red interna de docker-compose.prod.yml, ver deploy/README.md.
DATABASE_URL=postgres://camevo:camevo@localhost:5432/camevo
API_PORT=3001
# Orígenes permitidos por CORS, separados por coma. Sin definir, la API
# solo permite los puertos locales de Vite (desarrollo). En producción,
# fijarla a la URL real del sitio:
# CORS_ORIGIN=https://camevo.ibsen-soto.pro

# apps/web (Fase 5 — solo aplica a la build de producción de Vite; en
# desarrollo el proxy de Vite ya sabe llegar a la API en localhost:3001,
# no hace falta definirla). Vite inlina este valor en el bundle en tiempo
# de BUILD, no de ejecución — ver apps/web/Dockerfile.
# VITE_API_URL=https://camevo.ibsen-soto.pro

# docker-compose.prod.yml — puerto donde camevo-web publica su Nginx
# interno en 127.0.0.1 del host, para que el Nginx del host lo alcance
# (ver deploy/nginx/camevo.conf). No aplica en desarrollo.
# WEB_PORT=8090
